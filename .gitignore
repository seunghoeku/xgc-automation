# secrets / local env
.env
.env.local
# Google service account keys for the optional Sheets mirror. Keep them
# outside the repository; this is a backstop, not the intended location.
*service-account*.json
*credentials*.json

# derived from the remote XGC source; regenerated on demand, keyed by commit
.cache/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.uv/

# XGC output (large; never kept locally)
runs/**/*.bp
runs/**/*.bp.dir/
# Development and scheduler-test provenance is local-only. Curated master
# provenance remains eligible for review and version control.
runs/test/
*.bp
*.bp.dir/

# OS
.DS_Store
machines.local.yaml
kb/cases/*.local.yaml

# f_init procedure: pulled comparison plots are regenerable; keep the JSON.
f_init/cases/*/*.png
