# secrets / local env
.env
.env.local
# Google service account keys for the optional Sheets mirror. Keep them
# outside the repository; this is a backstop, not the intended location.
*service-account*.json
*credentials*.json

# derived from the remote XGC source; regenerated on demand, keyed by commit
.cache/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.uv/

# XGC output (large; never kept locally)
runs/**/*.bp
runs/**/*.bp.dir/
# Development and scheduler-test provenance is local-only. Curated master
# provenance remains eligible for review and version control.
runs/test/
*.bp
*.bp.dir/

# OS
.DS_Store
machines.local.yaml
kb/cases/*.local.yaml

# f_init procedure: pulled comparison plots are regenerable; keep the JSON.
f_init/cases/**/*.png

# Claude Code personal overrides (machine-specific paths)
.claude/settings.local.json

# Derived view of kb/simulations/*.yaml; rebuilt by every submission and by
# `xgc-sim sync-notebook --confirm`. Tracking it made two machines conflict on
# every submission (docs/simulation-catalog.md, "CSV notebook").
kb/simulation_notebook.csv
kb/simulation_notebook.csv.tmp

# One user's state. It lives in a catalog repository (XGC_CATALOG_DIR or
# ~/.config/xgc-automation/config.yaml, see tools/paths.py and
# docs/simulation-catalog.md "Catalog repository"); with the default layout it
# would be created inside this checkout and must still never be committed here.
kb/simulations/
kb/simulation_registry.yaml
kb/simulation_registry.yaml.bak*
kb/bad_nodes.yaml
kb/cases/drafts/
runs/
input_backup/
f_init/cases/
flow_match/cases/
Other_data/
