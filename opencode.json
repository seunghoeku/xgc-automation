{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "xgc-tools": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "tools.server"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "uv run *": "allow",
      "sbatch *": "ask",
      "qsub *": "ask",
      "scancel *": "ask",
      "qdel *": "ask",
      "rm *": "ask",
      "scp *": "ask",
      "rsync *": "ask"
    },
    "edit": "ask",
    "webfetch": "allow"
  }
}
