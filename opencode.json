{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "xgc-tools": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "tools.server"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "sbatch *": "ask",
      "qsub *": "ask",
      "scancel *": "ask",
      "qdel *": "ask",
      "rm *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "git push*": "ask",
      "git commit*": "ask"
    },
    "edit": "allow",
    "external_directory": {
      "~/Documents/git/**": "allow",
      "~/.config/opencode/**": "allow"
    },
    "webfetch": "allow"
  }
}
