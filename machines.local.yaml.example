# machines.local.yaml — YOUR bindings for the machines in machines.yaml.
#
#   cp machines.local.yaml.example machines.local.yaml   # then edit
#
# This file is gitignored: it holds usernames, accounts, personal paths, and
# the names of YOUR ~/.ssh/config aliases. It is deep-merged over
# machines.yaml (dicts merge; scalars/lists here replace the committed
# value). You only need entries for machines you actually use, and only for
# the fields you are overriding.
#
# The ssh_config_host values must match Host aliases in your ~/.ssh/config.
# MFA hosts reuse your own ControlMaster socket; Perlmutter uses the NERSC
# key/certificate over a socket the toolchain owns. See docs/ssh-setup.md.
# Run `preflight` after editing to see what is still missing.

perlmutter:
  user: alice
  auth:
    # Alias must select IdentityFile and CertificateFile. Do not enable
    # ControlMaster for it; the tools also force multiplexing off.
    ssh_config_host: perlmutter
  paths:
    scratch: /pscratch/sd/a/alice    # echo $PSCRATCH
    run_root: /pscratch/sd/a/alice/xgc-runs
  defaults:
    account: m0000                   # your NERSC project
    mail_user: alice@example.org
  # Remote XGC_GUI Monitor runtime. The Python environment must import flask,
  # numpy, matplotlib, and adios2. No scheduler allocation is used.
  gui:
    source: /pscratch/sd/a/alice/XGC-Devel
    python: /pscratch/sd/a/alice/venvs/xgc-gui/bin/python3
    # env_script: /pscratch/sd/a/alice/env/xgc-gui.sh  # optional
    # remote_port: 5080  # optional; otherwise a high port is selected
  # Needed for analyze_run's oned_profiles product and for the optional f_init
  # procedure (f_init/README.md): a login-node Python with adios2, numpy,
  # scipy, matplotlib, and the path of YOUR XGC_reader checkout.
  analysis:
    python: /path/to/your/python3    # must be able to import xgc_analysis
    pythonpath: /path/to/XGC_reader  # parent of the xgc_analysis package
    # env_script: /path/sourced/before/running (optional)
  # HPC-Campaign archive when a simulation completes (docs/campaign.md).
  # python/pythonpath/env_script default to `analysis`; the interpreter must
  # import both xgc_analysis and hpc_campaign.
  # campaign:
  #   auto: true                   # off unless set
  #   pythonpath: /path/to/XGC-Analysis
  #   hostname: NERSC              # optional HPC-Campaign host alias
  #   auto_kinds: [production]     # default; add dev to package test runs

polaris:
  user: alice
  auth:
    ssh_config_host: polaris1        # whichever login node your alias targets
  paths:
    scratch: /grand/YourProject/alice
    run_root: /grand/YourProject/alice/xgc-runs
  xgc:
    # Your own build (docs/build-polaris.md). Leave out if you have none yet.
    # exe/src/env_script are read by the tools; xgca_exe and build are
    # recorded metadata (useful provenance, not consumed by code today).
    exe: /grand/YourProject/alice/XGC-Devel/build/bin/xgc
    xgca_exe: /grand/YourProject/alice/XGC-Devel/build/bin/xgca
    src: /grand/YourProject/alice/XGC-Devel
    build: /grand/YourProject/alice/XGC-Devel/build
    env_script: /grand/YourProject/alice/XGC-Devel/quickstart/modules_and_env/polaris.sh
  defaults:
    account: YourProject             # ALCF allocation/project name
  gui:
    source: /grand/YourProject/alice/XGC-Devel
    python: /grand/YourProject/alice/venvs/xgc-gui/bin/python3
    # env_script: /grand/YourProject/alice/env/xgc-gui.sh

aurora:
  user: alice
  auth:
    ssh_config_host: aurora          # your Aurora ControlMaster alias
  paths:
    scratch: /lus/flare/projects/YourProject/alice
    run_root: /lus/flare/projects/YourProject/alice/xgc-runs
  # Optional: your project's DAOS pool and a POSIX container in it (see the
  # daos comment in machines.yaml). Leave out to run on flare only.
  daos:
    pool: YourProject
    container: xgc
  xgc:
    # Your own oneAPI/SYCL build (XGC-Devel quickstart, cmake_configs/aurora.sh).
    exe: /lus/flare/projects/YourProject/alice/XGC-Devel/build/bin/xgc
    src: /lus/flare/projects/YourProject/alice/XGC-Devel
    env_script: /lus/flare/projects/YourProject/alice/XGC-Devel/quickstart/modules_and_env/aurora.sh
  defaults:
    account: YourProject             # ALCF allocation/project name

stellar:
  user: alice
  auth:
    ssh_config_host: stellar
  paths:
    scratch: /scratch/gpfs/alice
    run_root: /scratch/gpfs/alice/xgc-runs
  xgc:
    exe: /home/alice/git/XGC-Devel/build/bin/xgc
    src: /home/alice/git/XGC-Devel
    # env_script and remote_python are shared site installs and already set
    # in machines.yaml; override only if you use your own environment.
  defaults:
    account: pppl
  gui:
    source: /home/alice/git/XGC-Devel
    python: /home/alice/venvs/xgc-gui/bin/python3
    # env_script: /home/alice/env/xgc-gui.sh

stellarai:
  user: alice
  auth:
    method: key          # public key only, no Duo; office network or Princeton VPN
    batch_mode: false    # server adds an empty keyboard-interactive round (docs/ssh-setup.md)
    ssh_config_host: stellarai
  paths:
    # scratch is a per-group fileset on STELLAR-AI, not per user
    scratch: /scratch/gpfs/PTHEORY/alice
    run_root: /scratch/gpfs/PTHEORY/alice/xgc-runs
  xgc:
    # Checkout and build on scratch: /projects is not visible on compute nodes.
    exe: /scratch/gpfs/PTHEORY/alice/XGC-Devel/build/bin/xgc
    src: /scratch/gpfs/PTHEORY/alice/XGC-Devel
    env_script: /scratch/gpfs/PTHEORY/alice/XGC-Devel/quickstart/modules_and_env/stellarai_cpu.sh
  defaults:
    account: ptheory

# Optional: mirror the simulation catalog to a Google Sheet
# (docs/simulation-catalog.md). Requires `uv sync --extra sheets`, a service
# account shared on the spreadsheet as Editor, and a key file kept OUTSIDE
# this repository. Without this section the catalog and `xgc-sim` still work;
# only the spreadsheet mirror is unavailable.
common:
  sheet_sync:
    credentials: ~/.config/xgc/sheet-service-account.json
    spreadsheet_id: 1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
    worksheet: simulations
