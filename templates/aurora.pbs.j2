#!/bin/bash -l
#PBS -N {{ job_name }}
#PBS -l select={{ nodes }}
#PBS -l place=scatter
#PBS -l walltime={{ walltime }}
{% if filesystems %}
#PBS -l filesystems={{ filesystems }}
{% endif %}
{% if account %}
#PBS -A {{ account }}
{% endif %}
{% if queue %}
#PBS -q {{ queue }}
{% endif %}
{% if depend_on %}
#PBS -W depend=afterany:{{ depend_on }}
{% endif %}
#PBS -k doe

# PBS directives must remain above executable statements and ordinary comments.
# generated by: xgc-automation / {{ generated_at }}
# provenance: {{ provenance_id | default('n/a') }}
#
# Aurora profile (docs.alcf.anl.gov/aurora/running-jobs-aurora, XGC-Devel
# quickstart/{modules_and_env,runlines}/aurora.sh):
#   - unlike Polaris, `select=N:system=aurora` is rejected by qsub
#     ("Resource invalid in select specification: system", 2026-09-09), so the
#     chunk carries only the node count
#   - 2 sockets x 52 cores (cores 0 and 52 reserved for the OS), 208 logical CPUs
#   - 6 Intel PVC GPUs x 2 tiles = 12 tiles; XGC runs one MPI rank per tile
#   - jobs must be launched from /lus/flare project space, never from $HOME
set -euo pipefail

cd "{{ run_dir }}"
exec >"{{ run_dir }}/pbs-${PBS_JOBID}.out"
exec 2>"{{ run_dir }}/pbs-${PBS_JOBID}.err"

export TZ='/usr/share/zoneinfo/US/Central'
{% if env_script %}
source "{{ env_script }}"
{% endif %}
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% if mpich_lib %}
# Newer MPICH than the PE default, picked up through the library path:
# `module swap mpich/...` makes Lmod unload Kokkos, PETSc and ADIOS2, and the
# binary's RUNPATH yields to LD_LIBRARY_PATH (same MPICH ABI). The default
# 87e2045 leaks device memory every particle shift (d0048au); 51a9474 does not
# (d0067au, d0068au).
export LD_LIBRARY_PATH="{{ mpich_lib }}:${LD_LIBRARY_PATH:-}"
{% endif %}

export OMP_NUM_THREADS={{ cpus_per_task or 1 }}
export OMP_PROC_BIND=spread
# The explicit --cpu-bind list below already pins each rank's logical CPUs;
# OMP_PLACES on top of it fights the launcher (XGC's Aurora env unsets it too).
unset OMP_PLACES
export OMP_STACKSIZE="${OMP_STACKSIZE:-1G}"
# Aurora MPICH: GPU-aware MPI must match how the binary was built
# (XGC's Aurora cmake config passes -DUSE_GPU_AWARE_MPI=On).
export MPIR_CVAR_ENABLE_GPU={{ 1 if gpu_aware_mpi else 0 }}
export MPIR_CVAR_ALLTOALLV_PAIRWISE_NEW=1
{% if not gpu_ipc %}
# No intra-node GPU IPC: same-node GPU messages are staged through the host.
# With IPC the 2048-node particle shift hung in a Level Zero copy between GPUs
# g and g+4 (d0058au, d0065au), and the shift ran ~10x slower at 512 nodes
# (9.44 vs 1.83 s/step, d0068au vs d0071au). 2147483647 = INT_MAX, so no
# message is large enough for IPC; REPEAT_ADDR=0 stops the repeated-buffer
# trigger as well.
export MPIR_CVAR_CH4_IPC_GPU_P2P_THRESHOLD=2147483647
export MPIR_CVAR_CH4_IPC_MAP_REPEAT_ADDR=0
{% endif %}
# Lets XGC's device-memory usage report query the GPUs (Level Zero sysman).
export ZES_ENABLE_SYSMAN=1
# gpu_tile_compact.sh and --gpu-bind=list:<gpu>.<tile> both assume the
# COMPOSITE device hierarchy (the Aurora PE default; the frameworks module
# switches it to FLAT, which breaks both).
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE

{% if daos %}
# DAOS: XGC runs inside the project's POSIX container, mounted with dfuse on
# every node of this job (the PBS epilogue unmounts it). The case directory
# on flare keeps input, script, and these logs; the container keeps the run.
module use {{ daos.modulefiles }}
module load {{ daos.module }}
{{ daos.launch }} {{ daos.pool }}:{{ daos.container }}
mkdir -p "{{ daos.work_dir }}"
for f in input petsc.rc adios2cfg.xml; do
  [ -e "{{ run_dir }}/$f" ] && cp -f "{{ run_dir }}/$f" "{{ daos.work_dir }}/"
done
cd "{{ daos.work_dir }}"
echo "daos_work_dir={{ daos.work_dir }} mounted=$(mount | grep -c dfuse)"
{% endif %}
echo "host=$(hostname) job=${PBS_JOBID:-none} nodes={{ nodes }} start=$(date -Is)"
echo "ranks={{ total_ranks }} ranks_per_node={{ ntasks_per_node }} threads_per_rank=${OMP_NUM_THREADS}"
{% if xgc_exe %}
echo "libmpi=$(ldd "{{ xgc_exe }}" | grep -o '/[^ ]*/libmpi\.so\.[0-9]*' || true)"
{% endif %}

{% if xgc_exe %}
{% if ntasks_per_node == 12 %}
# One rank per GPU tile. Each rank gets 8 physical cores plus their
# hyperthreads (16 logical CPUs) on the socket that hosts its GPU; the gap at
# cores 49-52 keeps six ranks per socket (ALCF running-jobs, Example 4).
CPU_BIND="--cpu-bind=list:1-8,105-112:9-16,113-120:17-24,121-128:25-32,129-136:33-40,137-144:41-48,145-152:53-60,157-164:61-68,165-172:69-76,173-180:77-84,181-188:85-92,189-196:93-100,197-204"
GPU_BIND="--gpu-bind=list:0.0:0.1:1.0:1.1:2.0:2.1:3.0:3.1:4.0:4.1:5.0:5.1"
mpiexec --np {{ total_ranks }} -ppn {{ ntasks_per_node }} \
  ${CPU_BIND} ${GPU_BIND} --rlimits CORE -genvall \
{% if daos %}
  --no-vni --env LD_PRELOAD={{ daos.interception_library }} \
{% endif %}
  "{{ xgc_exe }}"{{ xgc_args | default('') }}
{% else %}
# Generic rank count: depth binding plus the ALCF round-robin tile wrapper.
mpiexec --np {{ total_ranks }} -ppn {{ ntasks_per_node }} \
  --depth={{ cpus_per_task or 1 }} --cpu-bind depth --rlimits CORE -genvall \
{% if daos %}
  --no-vni {{ daos.tile_wrapper }} "{{ xgc_exe }}"{{ xgc_args | default('') }}
{% else %}
  gpu_tile_compact.sh "{{ xgc_exe }}"{{ xgc_args | default('') }}
{% endif %}
{% endif %}
{% else %}
# no XGC executable specified -> hello-world verification mode
mpiexec --np {{ total_ranks }} -ppn {{ ntasks_per_node }}{% if daos %} --no-vni{% endif %} hostname
{% endif %}
{% if daos %}
echo "container listing of {{ daos.work_dir }}:"; ls -la "{{ daos.work_dir }}" | head -60
{% endif %}

echo "end=$(date -Is) rc=$?"
