#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --output={{ run_dir }}/slurm-%j.out
#SBATCH --error={{ run_dir }}/slurm-%j.err
#SBATCH --nodes={{ nodes }}
#SBATCH --time={{ walltime }}
{% if account %}
#SBATCH --account={{ account }}
{% endif %}
{% if partition %}
#SBATCH --partition={{ partition }}
{% endif %}
{% if qos %}
#SBATCH --qos={{ qos }}
{% endif %}
{% if constraint %}
#SBATCH --constraint={{ constraint }}
{% endif %}
{% if ntasks_per_node %}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
{% endif %}
{% if cpus_per_task %}
#SBATCH --cpus-per-task={{ cpus_per_task }}
{% endif %}
{% if gpus_per_node %}
#SBATCH --gpus-per-node={{ gpus_per_node }}
{% endif %}

# generated by: xgc-automation / {{ generated_at }}
# provenance: {{ provenance_id | default('n/a') }}
set -euo pipefail

{% if env_script %}
# Redirect stderr: the env script probes for compiler wrappers (mpicc etc.)
# that exist only on login nodes. Compute nodes carry a runtime-only MPI
# install, so `which` complains harmlessly. Silencing it keeps real errors
# visible in slurm-*.err. Verified: xgc resolves all libraries on compute nodes.
source {{ env_script }} 2>/dev/null
{% endif %}
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
cd {{ run_dir }}

{% if cpus_per_task %}
# Without this OpenMP defaults to the full core count per rank, oversubscribing
# the node by the number of ranks on it.
export OMP_NUM_THREADS={{ cpus_per_task }}
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
{% endif %}

echo "host=$(hostname) job=${SLURM_JOB_ID:-none} nodes={{ nodes }} start=$(date -Is)"
{% if cpus_per_task %}
echo "ranks={{ total_ranks }} threads_per_rank=${OMP_NUM_THREADS}"
{% endif %}

{% if xgc_exe %}
srun -n {{ total_ranks }} {{ xgc_exe }}
{% else %}
# no XGC executable specified -> hello-world verification mode
srun -n {{ total_ranks }} hostname
{% endif %}

echo "end=$(date -Is) rc=$?"
