#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --output={{ run_dir }}/slurm-%j.out
#SBATCH --error={{ run_dir }}/slurm-%j.err
#SBATCH --nodes={{ nodes }}
#SBATCH --time={{ walltime }}
{% if account %}
#SBATCH --account={{ account }}
{% endif %}
{% if partition %}
#SBATCH --partition={{ partition }}
{% endif %}
{% if qos %}
#SBATCH --qos={{ qos }}
{% endif %}
{% if depend_on %}
#SBATCH --dependency=afterany:{{ depend_on }}
{% endif %}
{% if constraint %}
#SBATCH --constraint={{ constraint }}
{% endif %}
{% if ntasks_per_node %}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
{% endif %}
{% if cpus_per_task %}
#SBATCH --cpus-per-task={{ cpus_per_task }}
{% endif %}
{% if gpus_per_node %}
#SBATCH --gpus-per-node={{ gpus_per_node }}
{% endif %}
{% if mail_type %}
#SBATCH --mail-type={{ mail_type }}
{% endif %}
{% if mail_user %}
#SBATCH --mail-user={{ mail_user }}
{% endif %}

# generated by: xgc-automation / {{ generated_at }}
# provenance: {{ provenance_id | default('n/a') }}
set -euo pipefail

{% if env_script %}
# The env script probes for compiler wrappers (mpicc etc.) that exist only on
# login nodes, so `which` complains harmlessly on compute nodes. Its stderr goes
# to env_setup.err in the run directory: slurm-*.err stays clean, and when the
# env script itself fails under `set -e` (stellarai job 274 died silently at
# this line) the reason is still on disk.
source {{ env_script }} 2> {{ run_dir }}/env_setup.err
{% endif %}
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
cd {{ run_dir }}

{% if cpus_per_task %}
# Without this OpenMP defaults to the full core count per rank, oversubscribing
# the node by the number of ranks on it.
export OMP_NUM_THREADS={{ cpus_per_task }}
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
{% endif %}

echo "host=$(hostname) job=${SLURM_JOB_ID:-none} nodes={{ nodes }} start=$(date -Is)"
{% if cpus_per_task %}
echo "ranks={{ total_ranks }} threads_per_rank=${OMP_NUM_THREADS}"
{% endif %}

{% if srun_cpu_binding and cpus_per_task %}
{% set srun_c = " -c " ~ cpus_per_task ~ " --cpu-bind=cores" %}
{% else %}
{% set srun_c = "" %}
{% endif %}
{% if gpus_per_node and ntasks_per_node and ntasks_per_node|int == gpus_per_node|int %}
{# One GPU per rank. Without it every rank sees all of the node's GPUs, and
   memsets issued from OpenMP threads (whose current device is 0) fail on
   another device's memory: stellarai d0030sa job 331 died in step 1 with
   cudaErrorInvalidValue in the collision Picard loop. #}
{% set srun_c = srun_c ~ " --gpus-per-task=1 --gpu-bind=single:1" %}
{% endif %}
{% if xgc_exe %}
srun -n {{ total_ranks }}{{ srun_c }} {{ xgc_exe }}
{% else %}
# no XGC executable specified -> hello-world verification mode
srun -n {{ total_ranks }}{{ srun_c }} hostname
{% endif %}

echo "end=$(date -Is) rc=$?"
